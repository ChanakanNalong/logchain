# Local Hardhat test environment (logchain-hh) — isolated from the real stack.
# Every value here is a dummy or a public Hardhat test value — safe to commit.
# Copy to .env.hardhat (gitignored). Shell-sourceable and usable as a compose env_file.
# ---- infra (consumed by hh-postgres / hh-vault-init) ----
POSTGRES_PASSWORD=hh-local-only
KEYCLOAK_DB_PASSWORD=hh-unused
KC_DB_PASSWORD=hh-unused
REPLICATION_PASSWORD=hh-unused
LOGCHAIN_CLIENT_SECRET=hh-unused
LOGCHAIN_INGESTOR_SECRET=hh-unused
LOGCHAIN_ADMIN_CLIENT_SECRET=hh-unused
ABUSEIPDB_KEY=
MAIL_USER=
MAIL_PASS=
MAIL_TO=
# Hardhat account #0 — public well-known test key (0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# ---- backend ----
NODE_ENV=production
PORT=13000
METRICS_PORT=19464
DB_HOST=127.0.0.1
DB_PORT=15433
VAULT_ADDR=http://127.0.0.1:18200
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
BLOCKCHAIN_TX_TIMEOUT_MS=30000
# Hardhat ไม่มี explorer — polygonscanUrl = null
BLOCKCHAIN_EXPLORER_TX_URL=
INTEGRITY_AUTO_REANCHOR=false
KAFKA_BROKERS=127.0.0.1:1
KAFKA_SSL_ENABLED=false
DETECTION_URL=
KEYCLOAK_URL=https://localhost:8443
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=logchain
ALLOWED_ORIGINS=http://localhost:13000
