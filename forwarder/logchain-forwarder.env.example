# /etc/logchain-forwarder.env — chmod 640 root:logchain-fwd (มี client secret)
LOGCHAIN_API_URL=https://logchain.example.org:3443/api/v1
LOGCHAIN_TOKEN_URL=https://logchain.example.org:8443/realms/logchain/protocol/openid-connect/token
LOGCHAIN_CLIENT_ID=vps-forwarder
LOGCHAIN_CLIENT_SECRET=
# CA ของ stack ถ้าใช้ cert ที่ออกเอง (infra/tls/certs/ca.crt) · ว่าง = CA ของระบบ
LOGCHAIN_CA_FILE=

# sshd: journal (journalctl <SSH_JOURNAL_ARGS> -f -o json) หรือ file (tail SSH_AUTH_LOG)
SSH_ENABLED=true
SSH_MODE=journal
SSH_JOURNAL_ARGS=-u ssh
SSH_AUTH_LOG=/var/log/auth.log

# access log ของ nginx (combined) หรือ Caddy (format json) — คั่นด้วย , ได้หลายไฟล์ · ว่าง = ไม่อ่าน
ACCESS_LOGS=/var/log/nginx/access.log
# true เฉพาะเมื่ออยู่หลัง Cloudflare และ log_format ต่อท้ายด้วย "$http_cf_connecting_ip" (ไม่งั้นใครก็ปลอม header ได้)
TRUST_CF_CONNECTING_IP=false

# เพดานต่อชั่วโมง (รวมทุก source) · dedup ข้อความซ้ำภายในกี่วินาที · log สรุปทุกกี่วินาที
RATE_PER_HOUR=300
DEDUP_SECONDS=10
SUMMARY_SECONDS=600
STATE_FILE=/var/lib/logchain-forwarder/state.json
# true = พิมพ์ payload แทนการส่ง (ทดสอบ)
DRY_RUN=false
