# Copy to detection/.env (gitignored) and fill in. DEV-ONLY placeholders.
# ใช้เฉพาะตอนรัน detection บน host เอง — โหมด docker compose ส่ง env ให้จาก
# บล็อก `environment:` ของ service `detection-api` / `detection-consumer` แทน

# ---- Kafka ----
# plaintext (EXTERNAL listener) -> localhost:29092,localhost:29093,localhost:29094
# mTLS      (SSL listener)      -> localhost:39092,localhost:39093,localhost:39094
KAFKA_BROKERS=localhost:29092,localhost:29093,localhost:29094
KAFKA_SSL_ENABLED=false
# PEM ทั้งสามไฟล์มาจาก ../infra/kafka/gen-certs.sh (ใช้ absolute path ได้)
KAFKA_SSL_CA=../infra/kafka/certs/ca.crt
KAFKA_SSL_CERT=../infra/kafka/certs/clients/detection.crt
KAFKA_SSL_KEY=../infra/kafka/certs/clients/detection.key
# วินาทีที่ยอมรอ broker ack ต่อ alert หนึ่งตัวก่อนถือว่าส่งไม่สำเร็จ
KAFKA_PUBLISH_TIMEOUT=10

# ---- FastAPI detect endpoint ที่ consumer ยิงไปหา ----
DETECT_URL=http://localhost:8000/api/v1/detect

# ---- Vault (AppRole `detection-service`) ----
# role_id / secret_id ถูกพิมพ์ออกมาโดย infra/vault/init.sh และเขียนลง
# infra/vault/.secrets/approle.env ให้ scripts/bootstrap.sh มาเติมให้อัตโนมัติ
VAULT_ADDR=http://localhost:8200
VAULT_DETECTION_ROLE_ID=CHANGE_ME
VAULT_DETECTION_SECRET_ID=CHANGE_ME
