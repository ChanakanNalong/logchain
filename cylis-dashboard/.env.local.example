NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=logchain
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=logchain-frontend
# 1 = serve logs/alerts from the in-memory mock (src/lib/mock) instead of the API.
# Dev only — Keycloak sign-in still applies. Leave unset/0 for any real build.
NEXT_PUBLIC_USE_MOCK=0
