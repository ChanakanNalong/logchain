# Copy to .env (gitignored) and fill in. The values below are DEV-ONLY
# placeholders — generate fresh secrets for any non-local environment.

DATABASE_URL=postgresql://logchain:CHANGE_ME@localhost:5433/logchain
KAFKA_BROKER=localhost:9092
# รายชื่อ broker ที่ client ใช้จริง (comma-separated)
#   plaintext (EXTERNAL listener) -> localhost:29092,localhost:29093,localhost:29094
#   mTLS      (SSL listener)      -> localhost:39092,localhost:39093,localhost:39094
KAFKA_BROKERS=localhost:29092,localhost:29093,localhost:29094

# --- Kafka mTLS (client -> SSL listener) ---
# false = plaintext เหมือนเดิม (default, ใช้กับ e2e/CI)
# true  = ต่อผ่าน mTLS — ต้องสลับ KAFKA_BROKERS ไปพอร์ต 39092-39094 ด้วย
KAFKA_SSL_ENABLED=false
# PEM ทั้งสามไฟล์มาจาก infra/kafka/gen-certs.sh (ใช้ absolute path ได้)
KAFKA_SSL_CA=./infra/kafka/certs/ca.crt
KAFKA_SSL_CERT=./infra/kafka/certs/clients/nestjs.crt
KAFKA_SSL_KEY=./infra/kafka/certs/clients/nestjs.key
PORT=3000
NODE_ENV=development

# Blockchain (Polygon Amoy testnet)
BLOCKCHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# รอ tx confirm ได้นานสุด (ms) — วัดจริงบน Amoy ~6.5 วิ, public RPC ช้ากว่านี้ได้
# ครบเวลาแล้วยังไม่ confirm: batch เป็น UNVERIFIED ให้รอบ verify ตามผลต่อ (ไม่ใช่ FAILED)
BLOCKCHAIN_TX_TIMEOUT_MS=120000
# private key อ่านจาก Vault (secret/data/logchain/blockchain) ไม่ใช่ไฟล์นี้
# ใช้เฉพาะ scripts/deploy-contract.mjs ตอน deploy contract
BLOCKCHAIN_PRIVATE_KEY=CHANGE_ME

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=logchain

# --- Keycloak / auth secrets (DEV-ONLY — never reuse in prod) ---
# Postgres app role
POSTGRES_PASSWORD=CHANGE_ME
# Keycloak <-> Postgres (keycloak DB role)
KC_DB_PASSWORD=CHANGE_ME
# Keycloak master-realm admin console (bootstraps the master admin).
# Do NOT use "admin" — pick a non-default username and a strong password
# (length 12, upper, lower, digit, != username).
KEYCLOAK_ADMIN=kc-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_Min12Chars
# Master-realm automation/CI service account (client_credentials — bypasses
# the interactive MFA browser flow). Use a strong, rotated secret.
MASTER_AUTOMATION_SECRET=CHANGE_ME
# logchain realm seed credentials (rendered into the realm import at startup).
# Must satisfy the realm passwordPolicy: length(12), upper, lower, digit, != username.
KEYCLOAK_ADMIN_USER_PASSWORD=CHANGE_ME_Min12Chars
# Confidential client secrets
LOGCHAIN_CLIENT_SECRET=CHANGE_ME
LOGCHAIN_INGESTOR_SECRET=CHANGE_ME
# Service account behind the Keycloak Admin REST proxy (logchain-admin-svc).
# Same value must be seeded to Vault at secret/logchain/keycloak -> admin_client_secret
LOGCHAIN_ADMIN_CLIENT_SECRET=CHANGE_ME

# Frontend dev server origin (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3003
# เปิดให้ระบบ re-anchor batch ที่ verify ไม่ได้เอง (dev/demo — production ปิด)
INTEGRITY_AUTO_REANCHOR=false
