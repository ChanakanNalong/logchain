{
  "realm": "logchain",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 900,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1) and notUsername and passwordHistory(4)",
  "browserFlow": "logchain-browser",
  "roles": {
    "realm": [
      { "name": "analyst",  "description": "View logs, alerts, integrity" },
      { "name": "operator", "description": "Acknowledge and resolve alerts" },
      { "name": "admin",    "description": "Full access" },
      { "name": "ingestor", "description": "POST logs only (service account)" },
      { "name": "auditor",  "description": "Read compliance reports" }
    ]
  },
  "clients": [
    {
      "clientId": "api-gateway",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LOGCHAIN_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "log-ingestor",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LOGCHAIN_INGESTOR_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "logchain-frontend",
      "name": "LogChain Dashboard (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3001/*", "http://localhost:3003/*"],
      "webOrigins": ["http://localhost:3001", "http://localhost:3003"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "enabled": true,
      "email": "admin@logchain.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "${KEYCLOAK_ADMIN_USER_PASSWORD}", "temporary": false }
      ],
      "requiredActions": ["CONFIGURE_TOTP"],
      "realmRoles": ["admin", "ingestor", "analyst", "operator"]
    },
    {
      "username": "service-account-log-ingestor",
      "enabled": true,
      "serviceAccountClientId": "log-ingestor",
      "realmRoles": ["ingestor"]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "logchain-browser",
      "description": "Browser flow with conditional OTP enforced for the admin role",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "logchain-browser-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "logchain-browser-forms",
      "description": "Username/password followed by conditional OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "logchain-conditional-otp",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "logchain-conditional-otp",
      "description": "Require OTP only when the user has the admin role",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticatorConfig": "logchain-admin-otp-role"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "logchain-admin-otp-role",
      "config": {
        "condition.user.role": "admin",
        "negate": "false"
      }
    }
  ]
}
