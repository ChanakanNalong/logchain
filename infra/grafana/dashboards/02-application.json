{
  "uid": "logchain-app",
  "title": "LogChain — Application Pipeline",
  "tags": ["logchain", "application"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Log Ingest Rate (logs/min)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "rate(consumer_messages_total[1m]) * 60",
        "legendFormat": "{{status}}"
      }],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 2,
      "title": "Alert Rate (alerts/min)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "rate(consumer_alerts_published_total[1m]) * 60",
        "legendFormat": "{{source_type}} / {{severity}}"
      }],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 3,
      "title": "Consumer Process Latency (p50/p95/p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, rate(consumer_process_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, rate(consumer_process_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, rate(consumer_process_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4,
      "title": "DeepLog Inference Latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, rate(deeplog_detect_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, rate(deeplog_detect_seconds_bucket[5m]))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 5,
      "title": "Anomalies by Type",
      "type": "piechart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "deeplog_anomaly_total",
        "legendFormat": "{{reason_type}}"
      }]
    },
    {
      "id": 6,
      "title": "FastAPI HTTP Request Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "rate(http_requests_total{job=\"fastapi-detect\"}[1m])",
        "legendFormat": "{{handler}} {{status}}"
      }]
    }
  ]
}
