# deploy บน server เพื่อน (NB-Lab · LXC CT141) — ใช้ผ่าน docker-compose.cloud.yml เท่านั้น · ขั้นตอน: docs/runbooks/deploy-cloud.md
# HTTPS จบที่ Cloudflare: เบราว์เซอร์ ─https─► Cloudflare ─tunnel─► cloudflared (container ของเพื่อนบน CT141)
#   ─http─► 172.17.0.1:80 (host) ─► Caddy :8080 → แยกตามชื่อ host ข้างล่าง
# ไม่มี ACME / cert ในเครื่อง · ชื่อ host มาจาก .env: DASHBOARD_HOST · API_HOST · AUTH_HOST
{
	# container รันเป็น non-root → ฟังพอร์ตสูง · docker map 172.17.0.1:80 → 8080
	http_port 8080
	auto_https off
	# ไม่เปิด admin API (:2019) — config เปลี่ยนด้วยการ restart container เท่านั้น
	admin off
	servers {
		# cloudflared อยู่ใน bridge ของ docker (172.17.0.0/16) — เชื่อ header จากวงนี้เท่านั้น
		# IP จริงของผู้ใช้มาใน Cf-Connecting-IP (Cloudflare เขียนเอง ไม่ใช่ค่าที่ client ส่ง)
		trusted_proxies static {$TUNNEL_TRUSTED_CIDR:172.17.0.0/16}
		client_ip_headers Cf-Connecting-IP
	}
	log {
		output stdout
		format json
	}
}

# access log ต่อ request (JSON) → ./logs/https-proxy/access.log บน host (forwarder อ่าน · source web-proxy)
# request.client_ip = IP จริงหลัง trusted_proxies + Cf-Connecting-IP · remote_ip = cloudflared (172.18.0.1)
# Caddy ตัด Authorization / Cookie ออกจาก log ให้เอง · dir บน host = 65534:adm 2750 → ไฟล์ 0640 กลุ่ม adm อ่านได้
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			mode 0640
		}
		format json
	}
}

(upstream) {
	reverse_proxy {args[0]} {
		# backend ตั้ง `trust proxy` 1 ชั้น (Caddy) → ตัวท้ายของ X-Forwarded-For ต้องเป็น IP ผู้ใช้
		# ไม่งั้น rate limit นับทุกคนเป็น IP ของ cloudflared
		header_up X-Forwarded-For {client_ip}
		# Caddy รับเป็น http แต่ผู้ใช้เข้ามาทาง https (Keycloak สร้าง redirect / cookie Secure ตามค่านี้)
		header_up X-Forwarded-Proto https
	}
}

# dashboard (Next.js) — NEXT_PUBLIC_* ตอน build ชี้ API_HOST / AUTH_HOST
http://{$DASHBOARD_HOST} {
	import access_log
	import upstream cylis-dashboard:3000
}

# backend API — NEXT_PUBLIC_API_URL = https://{API_HOST}/api/v1
http://{$API_HOST} {
	import access_log
	import upstream backend:3000
}

# Keycloak — KEYCLOAK_URL ใน .env ต้องเป็น https://{AUTH_HOST} (issuer ของ token)
http://{$AUTH_HOST} {
	import access_log
	import upstream keycloak:8080
}

# ชื่ออื่น / เข้าด้วย IP ตรง — ไม่ตอบอะไร
:8080 {
	import access_log
	respond 404
}
