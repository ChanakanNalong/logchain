{
  "uid": "logchain-security",
  "title": "LogChain — Security & Compliance",
  "tags": ["logchain", "security", "compliance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Total Alerts (last 1h)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(increase(consumer_alerts_published_total[1h]))"
      }],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 10, "color": "yellow"}, {"value": 50, "color": "red"}]}}}
    },
    {
      "id": 2,
      "title": "CRITICAL Alerts (last 1h)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(increase(consumer_alerts_published_total{severity=\"CRITICAL\"}[1h]))"
      }],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "red"}}}
    },
    {
      "id": 3,
      "title": "CDE Alerts (last 1h)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(increase(consumer_alerts_published_total{cde=\"true\"}[1h]))"
      }],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "orange"}}}
    },
    {
      "id": 4,
      "title": "Detection Source: Rule vs ML",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(consumer_alerts_published_total{source_type=\"rule_match\"}[1h]))", "legendFormat": "Rules"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(consumer_alerts_published_total{source_type=\"ml_anomaly\"}[1h]))", "legendFormat": "ML"}
      ]
    },
    {
      "id": 5,
      "title": "Alert Severity Distribution",
      "type": "piechart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by (severity) (consumer_alerts_published_total)",
        "legendFormat": "{{severity}}"
      }]
    },
    {
      "id": 6,
      "title": "Alerts: CDE vs Non-CDE",
      "type": "piechart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by (cde) (consumer_alerts_published_total)",
        "legendFormat": "CDE={{cde}}"
      }]
    },
    {
      "id": 7,
      "title": "Alert Rate Over Time (by source)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "rate(consumer_alerts_published_total[5m]) * 60",
        "legendFormat": "{{source_type}} ({{severity}})"
      }],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ]
}
