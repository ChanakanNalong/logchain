{
    "uid": "logchain-system",
    "title": "LogChain - System Overview",
    "tags": ["logchain", "system"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "10s",
    "time": {"from": "now-15m", "to": "now"},
    "panels": [
        {
            "id": 1,
            "title": "CPU Usage (host)",
            "type": "timeseries",
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
            "targets": [{
                "refId": "A",
                "datasource": {"type": "prometheus", "uid": "prometheus"},
                "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
                "legendFormat": "CPU %"
            }],
            "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}
        },
        {
            "id": 2,
            "title": "Memory Usage (host)",
            "type": "timeseries",
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
            "targets": [{
                "refId": "A",
                "datasource": {"type": "prometheus", "uid": "prometheus"},
                "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
                "legendFormat": "Memory %"
            }],
            "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}
        },
        {
            "id": 3,
            "title": "NestJS - Event Loop Lag",
            "type": "timeseries",
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
            "targets": [{
                "refId": "A",
                "datasource": {"type": "prometheus", "uid": "prometheus"},
                "expr": "logchain_nodejs_eventloop_lag_seconds",
                "legendFormat": "lag (s)"
            }],
            "fieldConfig": {"defaults": {"unit": "s"}}
        },
        {
            "id": 4,
            "title": "Nestjs - Memory (RSS)",
            "type": "timeseries",
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
            "targets": [{
                "refId": "A",
                "datasource": {"type": "prometheus", "uid": "prometheus"},
                "expr": "logchain_process_resident_memory_bytes",
                "legendFormat": "RSS"
            }],
            "fieldConfig": {"defaults": {"unit": "bytes"}}
        },
        {
            "id": 5,
            "title": "Services Up",
            "type": "stat",
            "datasource": {"type": "prometheus", "uid": "prometheus"},
            "gridPos": {"h": 6, "w": 24, "x": 0, "y": 16},
            "targets": [{
                "refId": "A",
                "datasource": {"type": "prometheus", "uid": "prometheus"},
                "expr": "up",
                "legendFormat": "{{job}}"
            }],
            "options": {
                "colorMode": "background",
                "graphMode": "none"
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
                    ]
                }
            }
        }
    ]
}
